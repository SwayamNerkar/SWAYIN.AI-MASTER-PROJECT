# SWAYIN.AI Environment Configuration

APP_NAME="SWAYIN.AI"
ENV="development"
DEBUG=true
TIMEZONE="Asia/Kolkata"

# Capital & Risk Configuration
INITIAL_CAPITAL=20000.0
MAX_RISK_PER_TRADE_PCT=2.0
MAX_DAILY_LOSS=1000.0
MAX_OPEN_POSITIONS=1
MIN_EXPECTED_NET_PROFIT=300.0
MIN_RISK_REWARD=1.5

# Technical Indicators & Features (Task 1.3)
RSI_PERIOD=14
ATR_PERIOD=14
ADX_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
VWAP_ENABLED=true
# Market Regime & Volatility Machine (Task 1.4)
REGIME_ADX_THRESHOLD=20.0
REGIME_TREND_SCORE_THRESHOLD=0.60
VOLATILITY_LOW_THRESHOLD=1.0
VOLATILITY_HIGH_THRESHOLD=2.5

# ML Prediction Pipeline (Task 1.5)
ML_DEFAULT_HORIZON=3
ML_TRAIN_RATIO=0.70
ML_VALIDATION_RATIO=0.15
ML_TEST_RATIO=0.15
ML_RANDOM_SEED=42

# Backtesting & Prediction Evaluation Engine (Task 1.6)
BACKTEST_DEFAULT_MODE="EXPANDING"
BACKTEST_INITIAL_TRAIN_BARS=100
BACKTEST_EVAL_WINDOW_BARS=10

DATA_FEED_MODE="MOCK"
MARKET_DATA_PROVIDER="mock"
MARKET_DATA_CACHE_ENABLED=true
MARKET_DATA_FRESHNESS_THRESHOLD_SECONDS=10.0
MARKET_DATA_DEFAULT_INTERVAL="1m"

# Broker Connection Mode (MOCK / GROWW)
BROKER_ADAPTER="MOCK"
PAPER_TRADING_ENABLED=true

# Database & Cache Settings
DATABASE_URL="postgresql+asyncpg://swayin_user:swayin_pass@localhost:5432/swayin_db"
REDIS_URL="redis://localhost:6379/0"

# Note: GROWW API keys are NOT used in Task 1.1 (Mock mode only)
GROWW_API_KEY=""
GROWW_API_SECRET=""
